    "Scanned documents are saved here. Point your camera at a page to begin.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ المستندات الممسوحة ضوئيًا هنا. وجّه الكاميرا نحو صفحة للبدء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gescannte Dokumente werden hier gespeichert. Richte die Kamera auf eine Seite, um zu beginnen."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos escaneados se guardan aquí. Apunta la cámara a una página para empezar."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Los documentos escaneados se guardan aquí. Apunta la cámara a una página para comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les documents numérisés sont enregistrés ici. Pointez l'appareil photo vers une page pour commencer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्कैन किए गए दस्तावेज़ यहाँ सेव होते हैं। शुरू करने के लिए कैमरे को किसी पेज पर पॉइंट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I documenti scansionati vengono salvati qui. Inquadra una pagina con la fotocamera per iniziare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os documentos digitalizados são salvos aqui. Aponte a câmera para uma página para começar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os documentos digitalizados são guardados aqui. Aponte a câmara para uma página para começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканированные документы сохраняются здесь. Наведите камеру на страницу, чтобы начать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taranan belgeler burada saklanır. Başlamak için kamerayı bir sayfaya doğrultun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描的文档会保存在这里。将相机对准页面即可开始。"
          }
        }
      }
    },
