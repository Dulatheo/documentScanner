    "Add a password so only people who have it can open this file. Available with Premium.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف كلمة مرور بحيث لا يتمكن من فتح هذا الملف إلا من يملكها. متوفر مع Premium."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge ein Passwort hinzu, damit nur Personen mit diesem Passwort die Datei öffnen können. Verfügbar mit Premium."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una contraseña para que solo quienes la tengan puedan abrir este archivo. Disponible con Premium."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega una contraseña para que solo quienes la tengan puedan abrir este archivo. Disponible con Premium."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un mot de passe pour que seules les personnes qui le connaissent puissent ouvrir ce fichier. Disponible avec Premium."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पासवर्ड जोड़ें ताकि केवल वही लोग इस फ़ाइल को खोल सकें जिनके पास यह हो। यह Premium के साथ उपलब्ध है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una password in modo che solo chi la possiede possa aprire questo file. Disponibile con Premium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma senha para que só quem a tiver possa abrir este arquivo. Disponível com o Premium."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma palavra-passe para que só quem a tiver possa abrir este ficheiro. Disponível com o Premium."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте пароль, чтобы открыть файл могли только те, у кого он есть. Доступно в Premium."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca parolaya sahip kişilerin bu dosyayı açabilmesi için bir parola ekleyin. Premium ile kullanılabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加密码后，只有知道密码的人才能打开此文件。此功能需要高级版。"
          }
        }
      }
    },
