    "$4.99/month. Cancel anytime.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "4.99 دولار شهريًا. يمكنك الإلغاء في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "4,99 $/Monat. Jederzeit kündbar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "4,99 $/mes. Cancela cuando quieras."
          }
        },
