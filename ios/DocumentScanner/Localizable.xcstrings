          "stringUnit": {
            "state": "translated",
            "value": "US$ 4,99/mês. Cancele quando quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "4,99 $/mês. Cancele quando quiser."
          }
        },
        "ru": {
