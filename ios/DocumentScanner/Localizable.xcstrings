    "Cancel anytime during your trial — you won't be charged early.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الإلغاء في أي وقت أثناء الفترة التجريبية — لن يتم خصم أي مبلغ مبكرًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kündige jederzeit während der Testphase — es wird nichts vorzeitig abgebucht."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela cuando quieras durante la prueba: no se te cobrará antes de tiempo."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela cuando quieras durante tu prueba: no se te cobrará antes de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulez à tout moment pendant l'essai — vous ne serez pas facturé avant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रायल के दौरान कभी भी रद्द करें — आपसे जल्दी चार्ज नहीं लिया जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla in qualsiasi momento durante la prova — non ti verrà addebitato nulla in anticipo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele quando quiser durante o teste — você não será cobrado antes da hora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancele quando quiser durante a avaliação — não será cobrado antes do tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмените в любой момент пробного периода — списания не будет."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme süresi boyunca istediğiniz zaman iptal edin — erken ücretlendirme yapılmaz."
