    "Anyone opening this PDF will need this password.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيحتاج أي شخص يفتح ملف PDF هذا إلى كلمة المرور هذه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer dieses PDF öffnet, benötigt dieses Passwort."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que abra este PDF necesitará esta contraseña."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera que abra este PDF necesitará esta contraseña."
