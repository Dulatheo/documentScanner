            "state": "translated",
            "value": "इस PDF को खोलने के लिए किसी को भी यह पासवर्ड चाहिए होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque apra questo PDF avrà bisogno di questa password."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem abrir este PDF vai precisar desta senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem abrir este PDF vai precisar desta palavra-passe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для открытия этого PDF потребуется этот пароль."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
