    "3 days free, then $4.99/month. Cancel anytime.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "3 أيام مجانية، ثم 4.99 دولار شهريًا. يمكنك الإلغاء في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "3 Tage kostenlos, danach 4,99 $/Monat. Jederzeit kündbar."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "3 días gratis, luego 4,99 $/mes. Cancela cuando quieras."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "3 días gratis, luego $4.99 USD/mes. Cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 jours gratuits, puis 4,99 $/mois. Annulez à tout moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "3 दिन मुफ़्त, फिर $4.99/माह। कभी भी रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "3 giorni gratis, poi 4,99 $/mese. Annulla in qualsiasi momento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "3 dias grátis, depois US$ 4,99/mês. Cancele quando quiser."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "3 dias grátis, depois 4,99 $/mês. Cancele quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "3 дня бесплатно, затем $4.99 в месяц. Отмена в любое время."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3 gün ücretsiz, ardından 4,99 $/ay. İstediğiniz zaman iptal edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前 3 天免费，之后每月 4.99 美元。可随时取消。"
          }
        }
      }
    },
    "Add Password": {
      "localizations": {
