    "Free plan is limited to %lld saved documents. Upgrade for unlimited storage, export this one without saving, or cancel.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقتصر الخطة المجانية على %lld مستندات محفوظة. قم بالترقية للحصول على مساحة تخزين غير محدودة، أو صدّر هذا المستند دون حفظه، أو ألغِ العملية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der kostenlose Plan ist auf %lld gespeicherte Dokumente begrenzt. Upgrade für unbegrenzten Speicherplatz, exportiere dieses Dokument, ohne es zu speichern, oder brich ab."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratuito está limitado a %lld documentos guardados. Mejora tu plan para almacenamiento ilimitado, exporta este sin guardarlo o cancela."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan gratuito está limitado a %lld documentos guardados. Mejora tu plan para almacenamiento ilimitado, exporta este sin guardarlo o cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'offre gratuite est limitée à %lld documents enregistrés. Passez à l'offre supérieure pour un stockage illimité, exportez ce document sans l'enregistrer, ou annulez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्री प्लान में केवल %lld दस्तावेज़ सेव किए जा सकते हैं। अनलिमिटेड स्टोरेज के लिए अपग्रेड करें, इसे बिना सेव किए एक्सपोर्ट करें, या रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano gratuito è limitato a %lld documenti salvati. Passa a Premium per l'archiviazione illimitata, esporta questo documento senza salvarlo oppure annulla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano gratuito é limitado a %lld documentos salvos. Faça upgrade para armazenamento ilimitado, exporte este sem salvar ou cancele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano gratuito está limitado a %lld documentos guardados. Mude para o plano superior para armazenamento ilimitado, exporte este sem guardar ou cancele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В бесплатном плане можно сохранить не более %lld документов. Оформите подписку для неограниченного хранения, экспортируйте этот документ без сохранения или отмените."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz plan en fazla %lld kayıtlı belgeyle sınırlıdır. Sınırsız depolama için yükseltin, bu belgeyi kaydetmeden dışa aktarın veya vazgeçin."
          }
        },
        "zh-Hans": {
