<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Actual color scheme is applied by Compose
         MaterialTheme (see ui/theme/Theme.kt); this XML theme mainly controls
         the pre-Compose window background / splash so first-frame paint
         matches the light design tokens. -->
    <style name="Theme.DocumentScanner" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
    </style>
</resources>
