<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera is used indirectly via the ML Kit Document Scanner GMS module,
         which handles its own camera UI/permission flow, but we declare the
         hardware feature + permission so the Play Store filters correctly
         and so a manual gallery-import fallback can request it if needed. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Used only by the CloudConvert test integration (DESIGN_SPEC §5/§9
         "Office format export") to upload the exported PDF and download
         the converted DOCX/XLSX/PPTX — the rest of the app is fully
         offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".DocumentScannerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DocumentScanner"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DocumentScanner"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exposes files under the app's internal storage (page images, exported
             PDFs/JPGs) to the OS share sheet / other apps without granting broad
             file access. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
