# Copy this file to local.properties (already gitignored, alongside the
# sdk.dir Android Studio writes there) and fill in your own values.

# CloudConvert API key (DESIGN_SPEC §5/§9 "Office format export" — test
# integration). Get one at https://cloudconvert.com (free tier: 25
# conversion minutes/day). Embedding it here is fine for local testing
# only — never ship a release build with a real key baked in like this;
# anyone can decompile the APK and steal it. Route through a backend proxy
# before shipping.
CLOUDCONVERT_API_KEY=your-api-key-here
